# Variables lues par docker-compose.yml. Copier en `.env` (à la racine, hors du dépôt) et remplir.

# Mot de passe PostgreSQL (obligatoire). Il n'est appliqué qu'à la création du volume `db-data` :
# sur une base existante, garder celui d'origine (`newmannheim` avant qu'il soit obligatoire).
POSTGRES_PASSWORD=

# Captcha Cloudflare Turnstile à l'inscription ; vides = désactivé.
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=

# APK Android (`docker compose run --rm apk`) : mot de passe de la clé android/keystore/newmannheim.jks
# (obligatoire pour compiler l'APK). Une clé existante garde son mot de passe (`newmannheim` avant qu'il soit obligatoire).
APK_KEYSTORE_PASSWORD=
# Adresse proposée au premier lancement de l'app (ex. http://192.168.1.10:8080) ; facultatif.
APK_SERVER_URL=
